# Copy to .env and adjust for your VM. Compose reads this automatically.

# Public port the site is served on (use 80 for a plain http://<vm-ip> URL).
WEB_PORT=80

# Postgres credentials — change these to strong values on a real server.
POSTGRES_USER=wordcloud
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=wordcloud
